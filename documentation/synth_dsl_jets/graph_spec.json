    "logA_k": "log(velocity) + log(envelope) + log(H_k) + ln(10)/20 * S(f_k)",
    "harmonic_phase": "k * phase + psi_k",
    "audio_note": "sum_k exp(logA_k) * sin(harmonic_phase_k) + masked/fractal noise"
  },
